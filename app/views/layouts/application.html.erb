<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Communitools" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    
    <!--
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    -->

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body>
    <div class="max-w-[768px] min-h-screen mx-auto flex flex-col">
      <div class="header">
        <h1>Communitools</h1>
        <div class="flash-container">
          <% if notice %>
            <p class=""><%= notice %></p>
          <% elsif  alert%>
            <p class=""><%= alert %></p>
          <% end %>
        </div>
      </div>
      <div class="middle-container">
        <div class="sidebar-container">
          <div class="sidebar">
            <%= link_to "Profile", user_path %>
            <%= link_to "Tools", tools_path %>
            <%= link_to "Nearby", nearby_path %>
          </div>
        </div>
        <div class="main-container">
          <div class="main">
            <%= yield %>
          </div>
        </div>
      </div>
      <div class="footer">
        <% if user_signed_in? %>
          <%= link_to "Logout", destroy_user_session_path, data: { "turbo-method": :delete } %>
        <% elsif current_page?("/about") || current_page?("/") %>
          <%= link_to "Login", new_user_session_path %>
          <%= link_to "Sign Up", new_user_registration_path %>
        <% elsif current_page?("/users/sign_up") %>
          <%= link_to "Login", new_user_session_path %>
        <% elsif current_page?("/users/sign_in") %>
          <%= link_to "Sign Up", new_user_registration_path %>
        <% end %>
        <%= link_to "About", about_path %>
      </div>
    </div>
  </body>
</html>
