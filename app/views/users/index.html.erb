<% content_for :head do %>
  <%= javascript_import_module_tag "leaflet" %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <%= javascript_import_module_tag "slippy_map" %>
<% end %>

<h2><%= current_user.name %></h2>
<%= link_to 'Edit', edit_user_registration_path %>

<div class="">
  <div class=""><%= current_user.username %></div>
</div>
<div class="">
  <div class=""><%= current_user.email %></div>
</div>
<div class="">
  <div class="">Distance: <%= current_user.max_distance %></div>
</div>
<div class="">
  <div class=" latlng"><%= current_user.latlng || "No location" %></div>
</div>
<div class="map" style="height: 180px; width: 360px" id="display-map"></div>

<div class="">
  <div class="">
    You have <%= current_user.tools.size %> <a href="/tools">tools</a>
  </div>
</div>
<div class="">
  <div class="">
    There are <%= current_user.total_neighbours %> total users on the platform, <%= current_user.nearby_users.size %> of which are nearby and sharing <%= current_user.nearby_tools.size %> <a href="/nearby">tools</a>!
  </div>
</div>