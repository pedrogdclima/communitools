<% content_for :head do %>
  <%= javascript_import_module_tag "leaflet" %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <%= javascript_import_module_tag "slippy_map" %>
<% end %>

<h2><%= current_user.name %></h2>

<p class="">
  You have <%= current_user.nearby_users.size %> nearby neighbours sharing <%= current_user.nearby_tools.size %> <a href="/nearby">tools</a>!
</p>
<br>

<div class="flex flex-col gap-1">
  <p>Username: <%= current_user.username %></p>
  <p>Email: <%= current_user.email %></p>
  <p>Distance: <%= current_user.max_distance %> km</p>
</div>
<div class="hidden">
  <div class="latlng"><%= current_user.latlng || "No location" %></div>
</div>
<div class="map" style="height: 180px; width: 360px" id="display-map"></div>

<%= link_to "Update Profile", edit_user_registration_path %>
