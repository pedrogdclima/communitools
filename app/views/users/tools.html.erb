<h2>Your Tools</h2>

<div class="card-container">
  <% current_user.tools.each do |tool| %>
    <div class="tool-card">
      <%= link_to truncate(tool.name, length: 13), tool_path(tool.id) %>
      <% if tool.photo.attached? %>
      <%= image_tag(tool.photo.variant(:thumb), size: "100", class: "tool-thumbnail") %>
      <% else %>
      <%= image_tag("no_photo.png", size: "100", class: "tool-thumbnail") %>
      <% end %>
    </div>
  <% end %>

  <div class="tool-card">
      <%= link_to "Add Tool", new_tool_path %>
      <%= image_tag("add_tool.png", size: "100", class: "tool-thumbnail") %>
  </div>
</div>
