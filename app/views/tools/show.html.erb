<h2><%= @tool.name %></h2>

<% if current_user.id != @tool.user_id %>
<div class="">
  <div class="">Owner</div>
  <div class=""><%= @tool.user.name %></div>
</div>
<% end %>

<div class="">
  <div class="">Brand</div>
  <div class=""><%= @tool.brand.blank? ? 'No brand provided' : @tool.brand %></div>
</div>

<div class="">
  <div class="">Description</div>
  <div class=""><%= @tool.desc.blank? ? 'No description provided' : @tool.desc %></div>
</div>

<div class="">
  <div class="">Photo</div>
  <%= @tool.photo.attached? ? image_tag(@tool.photo, class: "tool-full-image") : (tag.div "No photo provided") %>
</div>

<div class="">
  <div class="">
    <%= link_to "Edit", edit_tool_path(@tool.id) %>
  </div>
  <div class="">
    <%= button_to "Delete", @tool, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
